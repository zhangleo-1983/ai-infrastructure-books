{
  "name": "ai-infrastructure-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:site && npm run build:search",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "book:new": "node scripts/create-book.mjs",
    "check:content:series": "vitest run tests/unit/series-content.test.ts",
    "check:content:book01": "node scripts/check-book01-content.mjs",
    "check:content:book02": "node scripts/check-content-integrity.mjs",
    "check:content:book03": "vitest run tests/unit/book03-content.test.ts tests/unit/book03-qa.test.ts",
    "check:content": "npm run check:content:series && npm run check:content:book01 && npm run check:content:book02 && npm run check:content:book03",
    "check:links": "node scripts/check-internal-links.mjs dist",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:content && npm run check:links",
    "check:all": "npm run check && npm run check:release && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.0.0",
    "lighthouse": "^13.4.1",
    "node-html-parser": "^9.0.0",
    "pagefind": "1.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
