---
import CopyButton from "./CopyButton.astro";

interface Props {
  code: string;
  label?: string;
}

const { code, label = "Terminal" } = Astro.props;
---

<figure class="code-block">
  <figcaption>
    <span>{label}</span>
    <CopyButton value={code} />
  </figcaption>
  <pre><code>{code}</code></pre>
</figure>

<style>
  .code-block {
    overflow: hidden;
    max-width: 100%;
    border: 1px solid #273446;
    border-radius: var(--radius-lg);
    background: var(--color-terminal);
    color: var(--color-terminal-text);
  }

  figcaption {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: var(--color-terminal-raised);
    padding: var(--space-2) var(--space-3);
    color: #aab7c8;
    font-size: var(--font-size-xs);
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
    margin: 0;
    padding: var(--space-5);
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  code {
    color: inherit;
    white-space: pre;
  }

  @media print {
    .code-block {
      border-color: #999999;
      background: #f5f5f5;
      color: #111111;
      break-inside: avoid;
    }

    figcaption {
      border-bottom: 1px solid #bbbbbb;
      background: #e9e9e9;
      color: #333333;
    }

    pre {
      overflow: visible;
      padding: 3mm;
      white-space: pre-wrap;
    }

    code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }
</style>
