---
interface Props {
  value: string;
}

const { value } = Astro.props;
---

<button
  class="copy-button"
  type="button"
  data-copy-button
  data-copy-value={value}
  data-copy-state="idle"
  aria-label="复制命令"
  hidden
>
  复制
</button>
<span class="visually-hidden" data-copy-feedback aria-live="polite"></span>

<style>
  .copy-button {
    border: 1px solid #43546a;
    border-radius: var(--radius-sm);
    background: #293749;
    color: #edf5ff;
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    font-size: var(--font-size-xs);
  }

  .copy-button:hover {
    border-color: #8dc2ff;
    color: white;
  }

  .copy-button[data-copy-state="success"] {
    border-color: #71d6a0;
    color: #a5efc5;
  }

  .copy-button[data-copy-state="error"] {
    border-color: #ff9d9d;
    color: #ffd1d1;
  }

  @media print {
    .copy-button {
      display: none;
    }
  }
</style>
