---
import type { BookDefinition } from "../../data/books";
import { seriesTitle } from "../../data/books";
import {
  bookHref,
  printHref as getPrintHref,
} from "../../lib/book-content";
import { sitePath } from "../../lib/site-path";

interface Props {
  book: BookDefinition;
  updatedAt: string;
  startHref?: string;
  printHref?: string;
  showDetails?: boolean;
  showActions?: boolean;
}

const {
  book,
  updatedAt,
  startHref = bookHref(book),
  printHref = getPrintHref(book),
  showDetails = true,
  showActions = true,
} = Astro.props;
const formattedUpdatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Shanghai",
}).format(new Date(`${updatedAt}T00:00:00+08:00`));
const numberLabel = String(book.number).padStart(2, "0");
---

<header class="book-cover" id="cover" data-book-cover data-book-id={book.id}>
  <div class="book-cover__primary" data-prototype-cover>
    <p class="book-cover__kicker">{seriesTitle} · 第 {numberLabel} 册</p>
    <h1>
      {
        book.cover.titleLines.map((line, index) => (
          <>
            {line}
            {index < book.cover.titleLines.length - 1 && <br />}
          </>
        ))
      }
    </h1>
    <p class="book-cover__subtitle">{book.subtitle}</p>
    <ol class="book-cover__route" aria-label="本册学习路径">
      {
        book.cover.learningPath.map((item, index) => (
          <li>
            <span>{item}</span>
            {index < book.cover.learningPath.length - 1 && (
              <b aria-hidden="true" data-parity-ignore>→</b>
            )}
          </li>
        ))
      }
    </ol>
  </div>

  {
    showDetails && (
      <div class="book-cover__details" aria-label="阅读说明">
        <div>
          <span aria-hidden="true">👤</span>
          <h2>适合谁阅读</h2>
          <p>{book.cover.audience}</p>
        </div>
        <div>
          <span aria-hidden="true">🎯</span>
          <h2>完成后能获得什么</h2>
          <p>{book.cover.outcome}</p>
        </div>
        <div>
          <span aria-hidden="true">☑</span>
          <h2>阅读前准备</h2>
          <p>{book.cover.prerequisites}</p>
        </div>
      </div>
    )
  }

  <div class="book-cover__footer">
    <p>
      <b>在线版</b><br />
      内容校订日期：{formattedUpdatedAt}
    </p>
    {showActions && (
      <nav
        class="book-cover__actions"
        aria-label={`${book.cover.navigationLabel}阅读入口`}
        data-print-hidden
      >
        <a class="book-cover__start" href={sitePath(startHref)}>
          开始阅读 <span aria-hidden="true">→</span>
        </a>
        <a class="book-cover__print" href={sitePath(printHref)}>
          整册打印
        </a>
      </nav>
    )}
    <span class="book-cover__number" aria-hidden="true">{numberLabel}</span>
  </div>
</header>

<style>
  .book-cover {
    position: relative;
    display: flex;
    min-height: 42rem;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
    border: var(--border-thin);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        circle at 88% 12%,
        color-mix(in srgb, var(--color-primary) 22%, transparent),
        transparent 34%
      ),
      radial-gradient(
        circle at 10% 90%,
        color-mix(in srgb, var(--color-primary) 10%, transparent),
        transparent 30%
      ),
      var(--color-surface);
    padding: var(--space-12);
    box-shadow: var(--shadow-soft);
  }

  .book-cover__kicker {
    display: inline-flex;
    border-radius: var(--radius-pill);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 780;
  }

  h1 {
    max-width: 48rem;
    margin-top: var(--space-5);
    font-size: var(--font-size-display);
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .book-cover__subtitle {
    max-width: 42rem;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: clamp(1.25rem, 3vw, 1.875rem);
  }

  .book-cover__route {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .book-cover__route li {
    display: contents;
  }

  .book-cover__route span {
    border: var(--border-thin);
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--color-surface) 76%,
      var(--color-primary-soft)
    );
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-sm);
  }

  .book-cover__route b {
    color: var(--color-primary);
  }

  .book-cover__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .book-cover__details > div {
    min-width: 0;
    border-top: var(--border-thin);
    padding-top: var(--space-4);
  }

  .book-cover__details span {
    font-size: var(--font-size-lg);
  }

  .book-cover__details h2 {
    margin-top: var(--space-2);
    font-size: var(--font-size-base);
  }

  .book-cover__details p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .book-cover__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: end;
    gap: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .book-cover__footer b {
    color: var(--color-text);
  }

  .book-cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .book-cover__actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-5);
    font-weight: 760;
    text-decoration: none;
  }

  .book-cover__start {
    background: var(--color-primary);
    color: white;
  }

  .book-cover__start:hover {
    background: var(--color-primary-strong);
    color: white;
  }

  .book-cover__print {
    border: var(--border-thin);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .book-cover__number {
    color: color-mix(in srgb, var(--color-primary) 18%, transparent);
    font-size: clamp(4rem, 9vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  @media (max-width: 48rem) {
    .book-cover__details {
      grid-template-columns: 1fr;
    }

    .book-cover__footer {
      grid-template-columns: 1fr auto;
    }

    .book-cover__actions {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  @media (max-width: 35.625rem) {
    .book-cover {
      min-height: 0;
      border-radius: var(--radius-lg);
      padding: var(--space-8) var(--space-5);
    }

    .book-cover__footer {
      align-items: end;
    }

    .book-cover__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .book-cover__number {
      font-size: 4rem;
    }
  }

  @media print {
    .book-cover {
      min-height: 245mm;
      break-after: page;
      border: 0;
      border-radius: 0;
      background: white;
      padding: 18mm 0 0;
      box-shadow: none;
    }

    .book-cover__details {
      gap: 5mm;
    }

    .book-cover__details > div {
      border-color: #bbbbbb;
    }

    .book-cover__footer {
      grid-template-columns: 1fr auto;
    }

    .book-cover__number {
      color: #dddddd;
    }
  }
</style>
