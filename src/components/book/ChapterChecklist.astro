---
interface Props {
  chapterId: string;
}

const { chapterId } = Astro.props;
const messageId = `${chapterId}-status`;
---

<div
  class="chapter-checklist"
  data-chapter-checklist
  data-pagefind-ignore
>
  <label>
    <input
      type="checkbox"
      name={chapterId}
      value="complete"
      aria-describedby={messageId}
      data-chapter-complete-control
    />
    <span><slot /></span>
  </label>
  <small
    id={messageId}
    data-chapter-status-message
    aria-live="polite"
  ></small>
</div>

<style>
  .chapter-checklist {
    border: 1px dashed var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-primary-soft);
    padding: var(--space-5);
  }

  label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
    font-weight: 680;
  }

  input {
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 auto;
    margin-top: 0.32rem;
    accent-color: var(--color-primary);
  }

  small {
    display: block;
    margin: var(--space-2) 0 0 1.875rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  [data-completed="true"] {
    border-style: solid;
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }

  @media print {
    .chapter-checklist {
      border-color: #888888;
      background: white;
    }

    input {
      display: none;
    }

    small {
      display: none;
    }

    label::before {
      content: "□";
      margin-right: 0.25em;
    }
  }
</style>
