---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<figure class="terminal-mock" aria-label={`终端仿真：${title}`}>
  <figcaption>
    <span class="terminal-mock__dots" aria-hidden="true" data-parity-ignore>
      <i></i><i></i><i></i>
    </span>
    <span>{title}</span>
  </figcaption>
  <div
    class="terminal-mock__content"
    tabindex="0"
    role="region"
    aria-label={`${title} 终端内容，可横向滚动`}
  ><slot /></div>
</figure>

<style>
  .terminal-mock {
    overflow: hidden;
    max-width: 100%;
    border: 1px solid #293648;
    border-radius: var(--radius-lg);
    background: var(--color-terminal);
    color: var(--color-terminal-text);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 18%);
  }

  figcaption {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-terminal-raised);
    padding: 0 var(--space-4);
    color: #aab7c8;
    font-size: var(--font-size-xs);
  }

  .terminal-mock__dots {
    display: flex;
    gap: 0.4rem;
  }

  i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #ff6e6e;
  }

  i:nth-child(2) {
    background: #ffd166;
  }

  i:nth-child(3) {
    background: #5ed18a;
  }

  .terminal-mock__content {
    min-height: 9rem;
    overflow-x: auto;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: 1.75;
    white-space: nowrap;
  }

  :global(.term-green) {
    color: #70d49a;
  }

  :global(.term-blue) {
    color: #8dc2ff;
  }

  :global(.term-white) {
    color: white;
  }

  .terminal-mock :global(a) {
    color: #9dcbff;
  }

  @media print {
    .terminal-mock {
      border-color: #999999;
      background: #f7f7f7;
      color: #111111;
      box-shadow: none;
      break-inside: avoid;
    }

    figcaption {
      border-bottom: 1px solid #bbbbbb;
      background: #e9e9e9;
      color: #333333;
    }

    .terminal-mock__dots {
      display: none;
    }

    .terminal-mock__content {
      min-height: 0;
      overflow: visible;
      padding: 3mm;
      white-space: normal;
    }

    :global(.term-green),
    :global(.term-blue),
    :global(.term-white) {
      color: #111111;
      font-weight: 700;
    }

    .terminal-mock :global(a) {
      color: #111111;
    }

    .terminal-mock :global(a[href^="http"]::after) {
      content: none;
    }
  }
</style>
