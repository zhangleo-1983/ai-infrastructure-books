---
import ReadingProgress from "../components/common/ReadingProgress.astro";
import SiteControls from "../components/common/SiteControls.astro";
import { seriesTitle } from "../data/books";
import { sitePath } from "../lib/site-path";
import { THEME_STORAGE_KEY } from "../scripts/constants";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/print.css";

interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: "website" | "article" | "book";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  robots = "index,follow",
  ogType = "website",
  structuredData,
} = Astro.props;
const documentTitle = title === seriesTitle ? title : `${title}｜${seriesTitle}`;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
const homeHref = sitePath("/");
const booksHref = sitePath("/books/");
const onHome = Astro.url.pathname === homeHref;
const onBooks = Astro.url.pathname.startsWith(booksHref);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f6fa" data-theme-color />
    <script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY }}>
      (() => {
        document.documentElement.dataset.js = "true";
        let mode = "system";
        try {
          const saved = localStorage.getItem(themeStorageKey);
          if (["system", "light", "dark"].includes(saved)) mode = saved;
        } catch {
          // Storage can be unavailable in privacy modes; system remains the default.
        }

        const root = document.documentElement;
        root.dataset.themeMode = mode;
        if (mode === "light" || mode === "dark") root.dataset.theme = mode;
        else delete root.dataset.theme;

        const resolvedDark =
          mode === "dark" ||
          (mode === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const themeColor = document.querySelector("[data-theme-color]");
        if (themeColor) {
          themeColor.content = resolvedDark ? "#0c121a" : "#f3f6fa";
        }
      })();
    </script>
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={seriesTitle} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      serializedStructuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializedStructuredData}
        />
      )
    }
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <ReadingProgress />
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={homeHref} aria-label={`${seriesTitle}首页`}>
          <span class="site-brand__mark" aria-hidden="true">AI</span>
          <span class="site-brand__name">{seriesTitle}</span>
        </a>
        <nav class="site-nav" aria-label="全站导航">
          <a href={homeHref} aria-current={onHome ? "page" : undefined}>首页</a>
          <a href={booksHref} aria-current={onBooks ? "page" : undefined}>书目</a>
        </nav>
        <SiteControls />
      </div>
    </header>
    <main class="site-main" id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      《AI 基础设施从零开始》· 面向零基础读者的中文技术图解书
    </footer>
    <script>
      import "../scripts/theme";
      import "../scripts/search";
      import "../scripts/reading-progress";
      import "../scripts/chapter-status";
      import "../scripts/copy";
      import "../scripts/mobile-toc";
    </script>
  </body>
</html>
