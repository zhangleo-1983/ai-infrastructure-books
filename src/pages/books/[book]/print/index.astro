---
import { getCollection, render } from "astro:content";
import BookCover from "../../../../components/book/BookCover.astro";
import ChapterHeader from "../../../../components/book/ChapterHeader.astro";
import PrintSectionHeading from "../../../../components/book/PrintSectionHeading.astro";
import type { BookDefinition } from "../../../../data/books";
import { getReadableBooks } from "../../../../data/books";
import {
  bookHref,
  chapterHref,
  entriesForBook,
  isPrintEligible,
} from "../../../../lib/book-content";
import BookLayout from "../../../../layouts/BookLayout.astro";
import { sitePath } from "../../../../lib/site-path";

type ChapterEntry = Awaited<ReturnType<typeof getCollection<"chapters">>>[number];

interface Props {
  book: BookDefinition;
  entries: ChapterEntry[];
}

export async function getStaticPaths() {
  const chapters = await getCollection(
    "chapters",
    ({ data }) => !data.draft,
  );

  return getReadableBooks().flatMap((book) => {
    if (!book.print.enabled) return [];
    const entries = entriesForBook(chapters, book).filter((entry) =>
      isPrintEligible(book, entry.data.chapterType),
    );
    if (entries.length === 0) return [];

    return [{
      params: { book: book.slug },
      props: { book, entries },
    }];
  });
}

const { book, entries }: Props = Astro.props;
const chapters = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    rendered: await render(entry),
  })),
);
const updatedAt = entries.reduce(
  (latest, entry) =>
    entry.data.updatedAt > latest ? entry.data.updatedAt : latest,
  "1970-01-01",
);
const firstEntry = entries[0];
---

<BookLayout
  title={`${book.shortTitle} · 整册打印`}
  description={book.print.description}
  bookTitle={book.shortTitle}
  robots={book.print.noindex ? "noindex,follow" : "index,follow"}
>
  <nav class="print-toolbar" aria-label="打印页操作" data-print-hidden>
    <a href={sitePath(bookHref(book))}>← 返回{book.cover.navigationLabel}目录</a>
    <button type="button" data-print-button>打印或导出 PDF</button>
  </nav>

  <div
    class="print-book book-prose"
    data-print-book
    data-book-id={book.id}
  >
    <BookCover
      book={book}
      updatedAt={updatedAt}
      startHref={firstEntry
        ? chapterHref(book, firstEntry.data.slug)
        : bookHref(book)}
      showDetails={true}
      showActions={false}
    />

    <nav class="print-contents" aria-labelledby="print-contents-title">
      <h2 id="print-contents-title">目录</h2>
      <ol>
        {
          entries.map((entry) => (
            <li>
              <a href={`#print-unit-${entry.data.slug}`}>
                <span>
                  {entry.data.chapterType === "chapter"
                    ? String(entry.data.chapterNumber).padStart(2, "0")
                    : entry.data.chapterType === "introduction"
                      ? "开始"
                      : entry.data.chapterType === "appendix"
                        ? "附录"
                        : "资料"}
                </span>
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      chapters.map(({ entry, rendered: { Content } }) => {
        const sourceAnchor = entry.data.sourceAnchor ?? entry.data.slug;
        const chapterNumberProps = entry.data.chapterNumber
          ? { chapterNumber: entry.data.chapterNumber }
          : {};
        return (
          <section
            class="print-chapter"
            id={`print-unit-${entry.data.slug}`}
            data-print-chapter
            data-order={entry.data.order}
            data-source-anchor={sourceAnchor}
          >
            <ChapterHeader
              title={entry.data.title}
              description={entry.data.description}
              sourceAnchor={`print-${sourceAnchor}`}
              chapterType={entry.data.chapterType}
              labels={entry.data.labels}
              headingLevel={2}
              {...chapterNumberProps}
            />
            <Content components={{ h2: PrintSectionHeading }} />
          </section>
        );
      })
    }
  </div>
</BookLayout>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-print-button]")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  .print-toolbar {
    position: sticky;
    top: calc(var(--height-header) + var(--space-3));
    z-index: 5;
    display: flex;
    max-width: var(--width-reading);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 auto var(--space-6);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    padding: var(--space-3);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(1rem);
  }

  .print-toolbar a {
    font-weight: 700;
    text-decoration: none;
  }

  .print-toolbar button {
    min-height: 2.75rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: white;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    font: inherit;
    font-weight: 760;
  }

  .print-book {
    max-width: var(--width-reading);
  }

  .print-chapter {
    margin-top: var(--space-16);
  }

  .print-contents {
    margin-top: var(--space-12);
    border-top: var(--border-thin);
    padding-top: var(--space-8);
  }

  .print-contents h2 {
    font-size: var(--font-size-xl);
  }

  .print-contents ol {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .print-contents li {
    border-bottom: var(--border-thin);
  }

  .print-contents a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  .print-contents a span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .print-chapter > * + * {
    margin-top: var(--space-6);
  }

  @media (max-width: 35.625rem) {
    .print-toolbar {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media print {
    .print-book {
      max-width: none;
      margin: 0;
    }

    .print-contents {
      min-height: 245mm;
      break-after: page;
      margin-top: 0;
      border-top: 0;
      padding-top: 12mm;
    }

    .print-contents a {
      padding-block: 2.5mm;
    }

    .print-chapter {
      break-before: page;
      margin-top: 0;
    }

    .print-chapter > * + * {
      margin-top: 4mm;
    }

    .print-chapter :global(.chapter-header--chapter) {
      break-before: auto;
    }
  }
</style>
