---
import { getCollection, render } from "astro:content";
import ChapterHeader from "../../../components/book/ChapterHeader.astro";
import ChapterNavigation from "../../../components/book/ChapterNavigation.astro";
import TableOfContents from "../../../components/book/TableOfContents.astro";
import {
  book02ChapterPlan,
  book02Id,
  type Book02ChapterPlanItem,
} from "../../../data/book02";
import { currentBook } from "../../../data/books";
import BookLayout from "../../../layouts/BookLayout.astro";
import { sitePath } from "../../../lib/site-path";

export async function getStaticPaths() {
  const chapters = await getCollection(
    "chapters",
    ({ data }) => data.book === book02Id && !data.draft,
  );

  return chapters.map((entry) => ({
    params: {
      book: entry.data.book,
      chapter: entry.data.slug,
    },
    props: { entry },
  }));
}

type ChapterEntry = Awaited<ReturnType<typeof getCollection<"chapters">>>[number];

interface Props {
  entry: ChapterEntry;
}

const { entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
const currentPlanIndex = book02ChapterPlan.findIndex(
  (item) => item.slug === entry.data.slug,
);
const previousPlan =
  currentPlanIndex > 0 ? book02ChapterPlan[currentPlanIndex - 1] : undefined;
const nextPlan =
  currentPlanIndex >= 0
    ? book02ChapterPlan[currentPlanIndex + 1]
    : undefined;

function navigationTarget(
  item: Book02ChapterPlanItem | undefined,
  label: string,
) {
  if (!item) return undefined;
  const target = {
    label,
    title: item.title,
    status: item.migrated ? ("available" as const) : ("pending" as const),
  };
  return item.migrated
    ? {
        ...target,
        href: sitePath(`/books/${book02Id}/${item.slug}/`),
      }
    : target;
}

const previousTarget = navigationTarget(previousPlan, "上一页");
const nextTarget = navigationTarget(nextPlan, "下一章");
const chapterNumberProps = entry.data.chapterNumber
  ? { chapterNumber: entry.data.chapterNumber }
  : {};
const navigationProps = {
  ...(previousTarget ? { previous: previousTarget } : {}),
  ...(nextTarget ? { next: nextTarget } : {}),
};
---

<BookLayout
  title={entry.data.title}
  description={entry.data.description}
  bookTitle={currentBook.shortTitle}
>
  <TableOfContents
    slot="sidebar"
    items={book02ChapterPlan}
    currentSlug={entry.data.slug}
    headings={headings}
  />

  <div class="book-prose" data-pagefind-body>
    <div data-migrated-content={entry.data.sourceAnchor}>
      <ChapterHeader
        title={entry.data.title}
        description={entry.data.description}
        sourceAnchor={entry.data.sourceAnchor}
        chapterType={entry.data.chapterType}
        labels={entry.data.labels}
        {...chapterNumberProps}
      />
      <Content />
    </div>

    <ChapterNavigation {...navigationProps} />
  </div>
</BookLayout>
