---
import { getCollection, render } from "astro:content";
import ChapterHeader from "../../../components/book/ChapterHeader.astro";
import ChapterNavigation from "../../../components/book/ChapterNavigation.astro";
import TableOfContents from "../../../components/book/TableOfContents.astro";
import type { BookDefinition } from "../../../data/books";
import {
  books,
  getBookById,
  getReadableBooks,
  isReadableBook,
} from "../../../data/books";
import {
  chapterHref,
  entriesForBook,
  isCompletionEligible,
  isSearchEligible,
  toBookTocItems,
} from "../../../lib/book-content";
import BookLayout from "../../../layouts/BookLayout.astro";
import { sitePath } from "../../../lib/site-path";

type ChapterEntry = Awaited<ReturnType<typeof getCollection<"chapters">>>[number];

interface Props {
  book: BookDefinition;
  entry: ChapterEntry;
}

const includeDrafts = import.meta.env.DEV;

export async function getStaticPaths() {
  const includeDraftEntries = import.meta.env.DEV;
  const availableBooks = includeDraftEntries
    ? books.filter(
        (book) => isReadableBook(book) || book.status === "drafting",
      )
    : getReadableBooks();
  const readableBookIds = new Set(availableBooks.map((book) => book.id));
  const chapters = await getCollection(
    "chapters",
    ({ data }) =>
      (includeDraftEntries || !data.draft) &&
      readableBookIds.has(data.book),
  );

  return chapters.flatMap((entry) => {
    const book = getBookById(entry.data.book);
    if (!book || entry.data.slug === "print") return [];

    return [{
      params: {
        book: book.slug,
        chapter: entry.data.slug,
      },
      props: { book, entry },
    }];
  });
}

const { book, entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
const allEntries = await getCollection(
  "chapters",
  ({ data }) =>
    data.book === book.id && (includeDrafts || !data.draft),
);
const bookEntries = entriesForBook(allEntries, book, { includeDrafts });
const tocItems = toBookTocItems(bookEntries, book);
const currentEntryIndex = bookEntries.findIndex(
  (item) => item.data.slug === entry.data.slug,
);
const previousEntry =
  currentEntryIndex > 0 ? bookEntries[currentEntryIndex - 1] : undefined;
const nextEntry =
  currentEntryIndex >= 0
    ? bookEntries[currentEntryIndex + 1]
    : undefined;

function navigationTarget(
  item: ChapterEntry | undefined,
  label: string,
) {
  if (!item) return undefined;
  return {
    label,
    title: item.data.title,
    href: sitePath(chapterHref(book, item.data.slug)),
    status: "available" as const,
  };
}

const previousTarget = navigationTarget(
  previousEntry,
  book.status === "drafting" ? "上一篇样章" : "上一页",
);
const nextTarget = navigationTarget(
  nextEntry,
  book.status === "drafting" ? "下一篇样章" : "下一章",
);
const chapterNumberProps = entry.data.chapterNumber
  ? { chapterNumber: entry.data.chapterNumber }
  : {};
const navigationProps = {
  ...(previousTarget ? { previous: previousTarget } : {}),
  ...(nextTarget ? { next: nextTarget } : {}),
};
const sourceAnchor = entry.data.sourceAnchor ?? entry.data.slug;
const completionEligible = isCompletionEligible(
  book,
  entry.data.chapterType,
);
const searchEligible = isSearchEligible(book, entry.data.chapterType);
const isDraftPreview = entry.data.draft || book.status === "drafting";
const draftLayoutProps = isDraftPreview
  ? { robots: "noindex,nofollow" }
  : {};
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": entry.data.chapterType === "chapter" ? "TechArticle" : "Article",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "zh-CN",
  dateModified: entry.data.updatedAt,
  isPartOf: {
    "@type": "Book",
    name: book.title,
  },
  ...(canonicalUrl ? { url: canonicalUrl, mainEntityOfPage: canonicalUrl } : {}),
};
---

<BookLayout
  title={`${entry.data.title} · ${book.shortTitle}`}
  description={entry.data.description}
  bookTitle={book.shortTitle}
  ogType="article"
  structuredData={structuredData}
  {...draftLayoutProps}
>
  <TableOfContents
    slot="sidebar"
    book={book}
    items={tocItems}
    currentSlug={entry.data.slug}
    headings={headings}
  />

  <div
    class="book-prose"
    data-chapter-status-root
    data-book-id={book.id}
    data-chapter-slug={entry.data.slug}
    data-completion-eligible={completionEligible ? "true" : "false"}
  >
    <div
      data-migrated-content={sourceAnchor}
      data-reading-content
      data-pagefind-body={searchEligible ? true : undefined}
      data-pagefind-meta={searchEligible
        ? `book:${book.search.resultBookLabel}`
        : undefined}
      data-pagefind-filter={searchEligible
        ? `book:${book.id}`
        : undefined}
    >
      <ChapterHeader
        title={entry.data.title}
        description={entry.data.description}
        sourceAnchor={sourceAnchor}
        chapterType={entry.data.chapterType}
        labels={entry.data.labels}
        {...chapterNumberProps}
      />
      <Content />
    </div>

    <ChapterNavigation {...navigationProps} />
  </div>
</BookLayout>
