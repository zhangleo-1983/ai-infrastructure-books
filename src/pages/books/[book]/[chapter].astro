---
import { getCollection, render } from "astro:content";
import ChapterHeader from "../../../components/book/ChapterHeader.astro";
import ChapterNavigation from "../../../components/book/ChapterNavigation.astro";
import TableOfContents from "../../../components/book/TableOfContents.astro";
import {
  book02Id,
  sortBookChapters,
  toBookTocItems,
} from "../../../data/book02";
import { currentBook } from "../../../data/books";
import BookLayout from "../../../layouts/BookLayout.astro";
import { sitePath } from "../../../lib/site-path";

export async function getStaticPaths() {
  const chapters = await getCollection(
    "chapters",
    ({ data }) => data.book === book02Id && !data.draft,
  );

  return sortBookChapters(chapters).map((entry) => ({
    params: {
      book: entry.data.book,
      chapter: entry.data.slug,
    },
    props: { entry },
  }));
}

type ChapterEntry = Awaited<ReturnType<typeof getCollection<"chapters">>>[number];

interface Props {
  entry: ChapterEntry;
}

const { entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
const bookEntries = sortBookChapters(
  await getCollection(
    "chapters",
    ({ data }) => data.book === book02Id && !data.draft,
  ),
);
const tocItems = toBookTocItems(bookEntries);
const currentEntryIndex = bookEntries.findIndex(
  (item) => item.data.slug === entry.data.slug,
);
const previousEntry =
  currentEntryIndex > 0 ? bookEntries[currentEntryIndex - 1] : undefined;
const nextEntry =
  currentEntryIndex >= 0
    ? bookEntries[currentEntryIndex + 1]
    : undefined;

function navigationTarget(
  item: ChapterEntry | undefined,
  label: string,
) {
  if (!item) return undefined;
  return {
    label,
    title: item.data.title,
    href: sitePath(`/books/${book02Id}/${item.data.slug}/`),
    status: "available" as const,
  };
}

const previousTarget = navigationTarget(previousEntry, "上一页");
const nextTarget = navigationTarget(nextEntry, "下一章");
const chapterNumberProps = entry.data.chapterNumber
  ? { chapterNumber: entry.data.chapterNumber }
  : {};
const navigationProps = {
  ...(previousTarget ? { previous: previousTarget } : {}),
  ...(nextTarget ? { next: nextTarget } : {}),
};
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": entry.data.chapterType === "chapter" ? "TechArticle" : "Article",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "zh-CN",
  dateModified: entry.data.updatedAt,
  isPartOf: {
    "@type": "Book",
    name: currentBook.title,
  },
  ...(canonicalUrl ? { url: canonicalUrl, mainEntityOfPage: canonicalUrl } : {}),
};
---

<BookLayout
  title={entry.data.title}
  description={entry.data.description}
  bookTitle={currentBook.shortTitle}
  ogType="article"
  structuredData={structuredData}
>
  <TableOfContents
    slot="sidebar"
    items={tocItems}
    currentSlug={entry.data.slug}
    headings={headings}
  />

  <div
    class="book-prose"
    data-chapter-status-root
    data-book-id={entry.data.book}
    data-chapter-slug={entry.data.slug}
    data-completion-eligible={entry.data.chapterType === "chapter" ? "true" : "false"}
  >
    <div
      data-migrated-content={entry.data.sourceAnchor}
      data-reading-content
      data-pagefind-body
      data-pagefind-meta={`book:${currentBook.shortTitle}`}
    >
      <ChapterHeader
        title={entry.data.title}
        description={entry.data.description}
        sourceAnchor={entry.data.sourceAnchor}
        chapterType={entry.data.chapterType}
        labels={entry.data.labels}
        {...chapterNumberProps}
      />
      <Content />
    </div>

    <ChapterNavigation {...navigationProps} />
  </div>
</BookLayout>
