---
import { getCollection } from "astro:content";
import BookCover from "../../../components/book/BookCover.astro";
import { currentBook } from "../../../data/books";
import TableOfContents from "../../../components/book/TableOfContents.astro";
import {
  book02Id,
  sortBookChapters,
  toBookTocItems,
} from "../../../data/book02";
import BookLayout from "../../../layouts/BookLayout.astro";

const bookEntries = sortBookChapters(
  await getCollection(
    "chapters",
    ({ data }) => data.book === book02Id && !data.draft,
  ),
);
const tocItems = toBookTocItems(bookEntries);
const updatedAt = bookEntries.reduce(
  (latest, entry) =>
    entry.data.updatedAt > latest ? entry.data.updatedAt : latest,
  "1970-01-01",
);
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: currentBook.title,
  description: currentBook.description,
  inLanguage: "zh-CN",
  dateModified: updatedAt,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
};
---

<BookLayout
  title={currentBook.shortTitle}
  description={currentBook.description}
  bookTitle={currentBook.shortTitle}
  ogType="book"
  structuredData={structuredData}
>
  <BookCover updatedAt={updatedAt} />

  <section class="book-index" aria-labelledby="book-index-title">
    <div>
      <p class="eyebrow">目录</p>
      <h2 id="book-index-title">完整目录</h2>
      <p>从“开始之前”到资料来源，全部内容均可直接阅读。</p>
    </div>
    <TableOfContents items={tocItems} />
  </section>
</BookLayout>

<style>
  .book-index {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-10);
    margin-top: var(--space-12);
    border-top: var(--border-thin);
    padding-top: var(--space-8);
  }

  .book-index h2 {
    margin-top: var(--space-2);
    font-size: var(--font-size-xl);
  }

  .book-index p:not(.eyebrow) {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  @media (max-width: 35.625rem) {
    .book-index {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media print {
    .book-index {
      display: none;
    }
  }
</style>
