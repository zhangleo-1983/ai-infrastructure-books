---
import {
  books,
  bookStatusLabel,
  isPublicBook,
  optionalBooks,
} from "../../data/books";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { bookHref } from "../../lib/book-content";
import { sitePath } from "../../lib/site-path";

const includeDrafts = import.meta.env.DEV;
const canBrowse = (book: (typeof books)[number]) =>
  isPublicBook(book) ||
  (includeDrafts && book.status === "drafting");
---

<BaseLayout
  title="全部书目"
  description="《AI 基础设施从零开始》系列书目与当前维护状态。"
>
  <header class="page-heading">
    <p class="eyebrow">Books</p>
    <h1>全部书目</h1>
    <p class="lede">
      主线前五册从基础设施走到自托管 AI 对话入口，第六册起转向普通用户更常用的
      AI 工作伙伴、Prompt、扩展能力、原型和评估方法。
    </p>
  </header>

  <section class="book-route" aria-labelledby="core-books-title">
    <div class="book-route__heading">
      <p class="eyebrow">Core route</p>
      <h2 id="core-books-title">主线阅读</h2>
      <p>按书号循序阅读；编写中的书册只展示规划状态。</p>
    </div>
  <ol class="book-list">
    {
      books.map((book) => (
        <li>
          <span class="book-list__number">
            {String(book.number).padStart(2, "0")}
          </span>
          <div>
            <h2>
              {canBrowse(book) ? (
                <a href={sitePath(bookHref(book))}>{book.title}</a>
              ) : (
                book.title
              )}
            </h2>
            <p>{book.description}</p>
          </div>
          <span class="status-label" data-status={book.status}>
            {bookStatusLabel(book.status)}
          </span>
        </li>
      ))
    }
  </ol>
  </section>

  <section class="book-route book-route--optional" aria-labelledby="optional-books-title">
    <div class="book-route__heading">
      <p class="eyebrow">Optional · Open source</p>
      <h2 id="optional-books-title">选读与开源共建</h2>
      <p>
        这些内容保留原 URL，适合有自托管、自动化、数据库或服务器运维兴趣的读者。
        实机状态以每册说明为准。
      </p>
    </div>
    <ol class="book-list">
      {
        optionalBooks.map((book) => (
          <li>
            <span class="book-list__number">
              {String(book.number).padStart(2, "0")}
            </span>
            <div>
              <h2>
                {canBrowse(book) ? (
                  <a href={sitePath(bookHref(book))}>{book.title}</a>
                ) : (
                  book.title
                )}
              </h2>
              <p>{book.optionalNote ?? book.description}</p>
            </div>
            <span class="status-label" data-status={book.status}>
              {bookStatusLabel(book.status)}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .page-heading,
  .book-route {
    width: min(100%, var(--width-content));
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .page-heading {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-16) var(--space-10);
  }

  .page-heading h1 {
    font-size: var(--font-size-display);
    letter-spacing: -0.055em;
  }

  .book-list {
    margin-block: 0;
    list-style: none;
  }

  .book-route {
    padding-bottom: var(--space-16);
  }

  .book-route__heading {
    max-width: var(--width-reading);
    padding-block: var(--space-8) var(--space-4);
  }

  .book-route__heading h2 {
    margin-top: var(--space-2);
    font-size: var(--font-size-2xl);
  }

  .book-route__heading p:not(.eyebrow) {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .book-route--optional {
    border-top: var(--border-thin);
  }

  .book-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: start;
    border-top: var(--border-thin);
    padding-block: var(--space-6);
  }

  .book-list__number {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-weight: 800;
  }

  .book-list h2 {
    font-size: var(--font-size-lg);
  }

  .book-list h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .book-list h2 a:hover {
    color: var(--color-primary);
  }

  .book-list p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  @media (max-width: 35.625rem) {
    .page-heading,
    .book-route {
      padding-inline: var(--space-4);
    }

    .book-list li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .book-list .status-label {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
